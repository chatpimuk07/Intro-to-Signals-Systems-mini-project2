# Task 3 (v2) timing constraints
create_clock -name clk50 -period 20.000 [get_ports {MAX10_CLK1_50}]
derive_pll_clocks
derive_clock_uncertainty

# All other I/O is asynchronous and synchronised inside the FPGA
# (switches, keys, SPI from ESP32, MCP3201 DOUT) or slow (LEDs, ADC SPI
# outputs generated by a 50 MHz state machine).
set_false_path -from [get_ports {KEY[*] SW[*] ESP_SPI_SCK ESP_SPI_CS_N ADC_SPI_MISO}]
set_false_path -to   [get_ports {LEDR[*] ESP_SPI_MISO FPGA_DATA_READY TIMING_DEBUG_PIN ADC_SPI_CS_N ADC_SPI_SCK}]
