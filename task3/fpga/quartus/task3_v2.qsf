# =========================================================================
# Task 3 (v2) - Quartus Prime Lite settings + pin assignments
# Board  : Terasic DE10-Lite   Device : 10M50DAF484C7G (MAX 10)
# Top    : task3_top (VHDL)
# =========================================================================
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY task3_top
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 484
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ---- source files (order: package first) ----
set_global_assignment -name VHDL_FILE ../rtl/sine_lut_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/sample_tick_gen.vhd
set_global_assignment -name VHDL_FILE ../rtl/mcp3201_ctrl.vhd
set_global_assignment -name VHDL_FILE ../rtl/test_tone_dds.vhd
set_global_assignment -name VHDL_FILE ../rtl/pingpong_buffer.vhd
set_global_assignment -name VHDL_FILE ../rtl/spi_slave_tx.vhd
set_global_assignment -name VHDL_FILE ../rtl/max10_adc_sampler.vhd
set_global_assignment -name VHDL_FILE ../rtl/task3_top.vhd
set_global_assignment -name SDC_FILE task3_v2.sdc

# ---- OPTIONAL: MAX 10 on-chip ADC (set USE_MAX10_ADC = true) ----
# Generate the IP (see README) and uncomment:
# set_global_assignment -name QIP_FILE ip/adc_pll.qip
# set_global_assignment -name QIP_FILE ip/max10_adc/synthesis/max10_adc.qip
# set_parameter -name USE_MAX10_ADC true

# ---- clock ----
set_location_assignment PIN_P11 -to MAX10_CLK1_50

# ---- push buttons (active low) ----
set_location_assignment PIN_B8 -to KEY[0]
set_location_assignment PIN_A7 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[1]

# ---- slide switches ----
set_location_assignment PIN_C10 -to SW[0]
set_location_assignment PIN_C11 -to SW[1]
set_location_assignment PIN_D12 -to SW[2]
set_location_assignment PIN_C12 -to SW[3]
set_location_assignment PIN_A12 -to SW[4]
set_location_assignment PIN_B12 -to SW[5]
set_location_assignment PIN_A13 -to SW[6]
set_location_assignment PIN_A14 -to SW[7]
set_location_assignment PIN_B14 -to SW[8]
set_location_assignment PIN_F15 -to SW[9]

# ---- red LEDs ----
set_location_assignment PIN_A8  -to LEDR[0]
set_location_assignment PIN_A9  -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_D13 -to LEDR[4]
set_location_assignment PIN_C13 -to LEDR[5]
set_location_assignment PIN_E14 -to LEDR[6]
set_location_assignment PIN_D14 -to LEDR[7]
set_location_assignment PIN_A11 -to LEDR[8]
set_location_assignment PIN_B11 -to LEDR[9]

# ---- Arduino header ----
# IO2..IO4 : external MCP3201 ADC
set_location_assignment PIN_AB7  -to ADC_SPI_CS_N
set_location_assignment PIN_AB8  -to ADC_SPI_SCK
set_location_assignment PIN_AB9  -to ADC_SPI_MISO
# IO8 : oscilloscope probe (8 kHz square wave = Fs/2)
set_location_assignment PIN_AB17 -to TIMING_DEBUG_PIN
# IO9 : block-ready handshake to ESP32
set_location_assignment PIN_AA17 -to FPGA_DATA_READY
# IO10, IO12, IO13 : SPI slave to ESP32 (IO11/MOSI not used)
set_location_assignment PIN_AB19 -to ESP_SPI_CS_N
set_location_assignment PIN_Y19  -to ESP_SPI_MISO
set_location_assignment PIN_AB20 -to ESP_SPI_SCK
# weak pull-up keeps the slave deselected if the ESP32 is not connected
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ESP_SPI_CS_N
